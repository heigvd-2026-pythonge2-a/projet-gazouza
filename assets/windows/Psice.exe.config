<?xml version="1.0" encoding="utf-8"?>
<!--
  .NET Framework configuration of Psice.exe, copied next to the executable by build.ps1.

  pywebview drives the WebView2 window through pythonnet. When Psice.zip is downloaded
  with a browser, Windows marks every extracted file as coming from the Internet, and
  .NET Framework then refuses to load Python.Runtime.dll and the WebView2 assemblies:
  the window never opens. loadFromRemoteSources lets it load the assemblies shipped
  with the application.
-->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
