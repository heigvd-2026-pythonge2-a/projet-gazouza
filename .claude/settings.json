{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv sync:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run python scripts/export_openapi.py)",
      "Bash(pnpm install:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm gen:api:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Edit(shared/openapi.json)",
      "Edit(frontend/src/api/schema.gen.ts)",
      "Edit(**/uv.lock)",
      "Edit(**/pnpm-lock.yaml)"
    ]
  }
}
