{
  "openapi": "3.1.0",
  "info": {
    "title": "Psice API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/library": {
      "get": {
        "summary": "Library",
        "description": "Every component type: pins and parameters (with defaults and labels), sorted by type.\n\nThe SPICE templates and models stay in the backend: they are not part of the contract.",
        "operationId": "library_api_library_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/LibraryComponent"
                  },
                  "type": "array",
                  "title": "Response Library Api Library Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Api Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/netlist": {
      "post": {
        "summary": "Generate Netlist",
        "description": "Schematic + analysis -> SPICE netlist (with its analysis line). Owner: Damien.",
        "operationId": "generate_netlist_api_netlist_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimulationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NetlistResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/simulate": {
      "post": {
        "summary": "Simulate",
        "description": "Schematic + analysis -> results. Owners: Damien (route), Antoine (engine).",
        "operationId": "simulate_api_simulate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimulationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimulationResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AcAnalysis": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "ac",
            "title": "Kind",
            "default": "ac"
          },
          "input_source_id": {
            "type": "string",
            "title": "Input Source Id",
            "description": "Component id of the source used as AC input."
          },
          "start_frequency": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Start Frequency"
          },
          "stop_frequency": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Stop Frequency"
          },
          "points_per_decade": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Points Per Decade",
            "default": 20
          }
        },
        "type": "object",
        "required": [
          "input_source_id",
          "start_frequency",
          "stop_frequency"
        ],
        "title": "AcAnalysis"
      },
      "Axis": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "'time', 'frequency' or the swept source name."
          },
          "unit": {
            "type": "string",
            "title": "Unit",
            "description": "'s', 'Hz', 'V' or 'A'."
          },
          "values": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Values"
          }
        },
        "type": "object",
        "required": [
          "name",
          "unit",
          "values"
        ],
        "title": "Axis",
        "description": "Independent variable (time, frequency or swept value). Absent for `.op`."
      },
      "Component": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Stable unique id, generated by the editor (e.g. 'c1')."
          },
          "type": {
            "type": "string",
            "title": "Type",
            "description": "Library id of the component (e.g. 'resistor', 'ground')."
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name",
            "description": "SPICE name shown to the user (e.g. 'R1'). Absent for 'ground' and 'label'."
          },
          "position": {
            "$ref": "#/components/schemas/Point"
          },
          "rotation": {
            "type": "integer",
            "enum": [
              0,
              90,
              180,
              270
            ],
            "title": "Rotation",
            "description": "Clockwise, in degrees.",
            "default": 0
          },
          "mirror": {
            "type": "boolean",
            "title": "Mirror",
            "description": "Horizontal mirror (x -> -x), applied before the rotation.",
            "default": false
          },
          "params": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Params",
            "description": "Parameter values as typed by the user, SPICE suffixes allowed (e.g. {'resistance': '1k'}). For a label: {'net': 'out'}."
          },
          "name_offset": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TextOffset"
              },
              {
                "type": "null"
              }
            ],
            "description": "Position of the name (or of a label's net name), set by hand. Absent: placed automatically."
          },
          "value_offset": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TextOffset"
              },
              {
                "type": "null"
              }
            ],
            "description": "Position of the value, set by hand. Absent: placed automatically."
          }
        },
        "type": "object",
        "required": [
          "id",
          "type",
          "position"
        ],
        "title": "Component",
        "description": "A placed component instance (including grounds and labels)."
      },
      "ComponentTarget": {
        "properties": {
          "comp": {
            "type": "string",
            "title": "Comp"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "comp"
        ],
        "title": "ComponentTarget"
      },
      "DcAnalysis": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "dc",
            "title": "Kind",
            "default": "dc"
          },
          "source_id": {
            "type": "string",
            "title": "Source Id",
            "description": "Component id of the swept source."
          },
          "start": {
            "type": "number",
            "title": "Start"
          },
          "stop": {
            "type": "number",
            "title": "Stop"
          },
          "step": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Step"
          }
        },
        "type": "object",
        "required": [
          "source_id",
          "start",
          "stop",
          "step"
        ],
        "title": "DcAnalysis"
      },
      "Diagnostic": {
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "NO_GROUND",
              "PIN_NOT_CONNECTED",
              "MISSING_NAME",
              "DUPLICATE_ID",
              "DUPLICATE_NAME",
              "BAD_PREFIX",
              "BAD_VALUE",
              "MISSING_PARAM",
              "UNKNOWN_TYPE",
              "UNKNOWN_ENDPOINT",
              "LABEL_CONFLICT",
              "LABEL_ON_GROUND",
              "BAD_LABEL_NAME",
              "AC_SOURCE_NOT_FOUND",
              "DC_SOURCE_NOT_FOUND",
              "WIRE_DANGLING",
              "JUNCTION_DANGLING",
              "MILLI_SUFFIX",
              "SHORTED_COMPONENT",
              "LED_OVERCURRENT",
              "LED_REVERSE_VOLTAGE",
              "SINGULAR_MATRIX",
              "VOLTAGE_SOURCE_LOOP",
              "NO_CONVERGENCE",
              "SIMULATION_TIMEOUT",
              "SIMULATION_FAILED"
            ],
            "title": "Code",
            "description": "Stable code, checked by the tests."
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "French message for the student. May change."
          },
          "targets": {
            "items": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/ComponentTarget"
                },
                {
                  "$ref": "#/components/schemas/PinTarget"
                },
                {
                  "$ref": "#/components/schemas/WireTarget"
                },
                {
                  "$ref": "#/components/schemas/JunctionTarget"
                },
                {
                  "$ref": "#/components/schemas/NetTarget"
                }
              ]
            },
            "type": "array",
            "title": "Targets",
            "description": "Elements to highlight. May be empty."
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "Diagnostic",
        "description": "An error or a warning. Whether it is one or the other depends on the list it is in."
      },
      "FreeEnd": {
        "properties": {
          "x": {
            "type": "integer",
            "title": "X"
          },
          "y": {
            "type": "integer",
            "title": "Y"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "x",
          "y"
        ],
        "title": "FreeEnd",
        "description": "Wire end attached to nothing (dangling). Produces a WIRE_DANGLING warning."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Junction": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Stable unique id (e.g. 'j1')."
          },
          "position": {
            "$ref": "#/components/schemas/Point"
          }
        },
        "type": "object",
        "required": [
          "id",
          "position"
        ],
        "title": "Junction",
        "description": "A point where wires meet outside a pin (a 'T')."
      },
      "JunctionEnd": {
        "properties": {
          "junction": {
            "type": "string",
            "title": "Junction",
            "description": "Junction id (e.g. 'j1')."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "junction"
        ],
        "title": "JunctionEnd",
        "description": "Wire end attached to a junction."
      },
      "JunctionTarget": {
        "properties": {
          "junction": {
            "type": "string",
            "title": "Junction"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "junction"
        ],
        "title": "JunctionTarget"
      },
      "LibraryComponent": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "description": "Library id (e.g. 'resistor'), used in `Component.type`."
          },
          "label": {
            "type": "string",
            "title": "Label",
            "description": "Name shown to the user, in French."
          },
          "prefix": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prefix",
            "description": "SPICE prefix ('R', 'C'...), first letter of `Component.name`. None for 'ground' and 'label', which have no name."
          },
          "pins": {
            "items": {
              "$ref": "#/components/schemas/PinDef"
            },
            "type": "array",
            "minItems": 1,
            "title": "Pins"
          },
          "params": {
            "items": {
              "$ref": "#/components/schemas/ParamDef"
            },
            "type": "array",
            "title": "Params"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "label",
          "prefix",
          "pins"
        ],
        "title": "LibraryComponent",
        "description": "One component type, as the editor sees it."
      },
      "NetTarget": {
        "properties": {
          "net": {
            "type": "string",
            "title": "Net"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "net"
        ],
        "title": "NetTarget",
        "description": "A SPICE node (e.g. 'n3'). The editor finds its wires through `NetlistResult.nets`."
      },
      "NetlistResult": {
        "properties": {
          "netlist": {
            "type": "string",
            "title": "Netlist",
            "description": "SPICE netlist, directly runnable by ngspice. Empty if there are errors.",
            "default": ""
          },
          "nets": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "object",
            "title": "Nets",
            "description": "SPICE node name -> ids of the wires belonging to that node."
          },
          "components": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Components",
            "description": "SPICE element name (e.g. 'R1') -> component id in the schematic."
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/Diagnostic"
            },
            "type": "array",
            "title": "Errors"
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/Diagnostic"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "type": "object",
        "title": "NetlistResult"
      },
      "OpAnalysis": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "op",
            "title": "Kind",
            "default": "op"
          }
        },
        "type": "object",
        "title": "OpAnalysis"
      },
      "ParamDef": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "label": {
            "type": "string",
            "title": "Label",
            "description": "Shown to the user, in French."
          },
          "unit": {
            "type": "string",
            "title": "Unit",
            "default": ""
          },
          "default": {
            "type": "string",
            "title": "Default",
            "description": "Written into `params` by the editor on placement."
          },
          "kind": {
            "type": "string",
            "enum": [
              "value",
              "text",
              "choice"
            ],
            "title": "Kind",
            "description": "'value': SPICE number ('1k'); 'text': free text (label name); 'choice': one of `options`.",
            "default": "value"
          },
          "options": {
            "items": {
              "$ref": "#/components/schemas/ParamOption"
            },
            "type": "array",
            "title": "Options",
            "description": "Allowed values, for 'choice'."
          },
          "waveforms": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Waveforms",
            "description": "Sources only: the waveforms that use this parameter (e.g. ['pulse', 'sin']). Empty: always shown."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "label",
          "default"
        ],
        "title": "ParamDef",
        "description": "A parameter the user can edit."
      },
      "ParamOption": {
        "properties": {
          "value": {
            "type": "string",
            "title": "Value",
            "description": "Stored in `params` (e.g. 'pulse')."
          },
          "label": {
            "type": "string",
            "title": "Label",
            "description": "Shown to the user, in French (e.g. 'Impulsion')."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "value",
          "label"
        ],
        "title": "ParamOption",
        "description": "One allowed value of a 'choice' parameter."
      },
      "PinDef": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "x": {
            "type": "integer",
            "title": "X"
          },
          "y": {
            "type": "integer",
            "title": "Y"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "x",
          "y"
        ],
        "title": "PinDef",
        "description": "A pin, with its position relative to the component at rotation 0 (grid units)."
      },
      "PinEnd": {
        "properties": {
          "comp": {
            "type": "string",
            "title": "Comp",
            "description": "Component id (e.g. 'c1')."
          },
          "pin": {
            "type": "string",
            "title": "Pin",
            "description": "Pin name from the library (e.g. '+', '1')."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "comp",
          "pin"
        ],
        "title": "PinEnd",
        "description": "Wire end attached to a component pin."
      },
      "PinTarget": {
        "properties": {
          "comp": {
            "type": "string",
            "title": "Comp"
          },
          "pin": {
            "type": "string",
            "title": "Pin"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "comp",
          "pin"
        ],
        "title": "PinTarget"
      },
      "Point": {
        "properties": {
          "x": {
            "type": "integer",
            "title": "X"
          },
          "y": {
            "type": "integer",
            "title": "Y"
          }
        },
        "type": "object",
        "required": [
          "x",
          "y"
        ],
        "title": "Point",
        "description": "Position on the grid, in grid units. The y axis points down."
      },
      "Schematic": {
        "properties": {
          "version": {
            "type": "integer",
            "const": 2,
            "title": "Version",
            "default": 2
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title",
            "description": "Used as the netlist header."
          },
          "components": {
            "items": {
              "$ref": "#/components/schemas/Component"
            },
            "type": "array",
            "title": "Components"
          },
          "junctions": {
            "items": {
              "$ref": "#/components/schemas/Junction"
            },
            "type": "array",
            "title": "Junctions"
          },
          "wires": {
            "items": {
              "$ref": "#/components/schemas/Wire"
            },
            "type": "array",
            "title": "Wires"
          },
          "texts": {
            "items": {
              "$ref": "#/components/schemas/Text"
            },
            "type": "array",
            "title": "Texts",
            "description": "Ignored by the netlist."
          }
        },
        "type": "object",
        "title": "Schematic",
        "description": "Root document, saved as-is on disk (`.psice.json`)."
      },
      "SimulationRequest": {
        "properties": {
          "schematic": {
            "$ref": "#/components/schemas/Schematic"
          },
          "analysis": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/OpAnalysis"
              },
              {
                "$ref": "#/components/schemas/TranAnalysis"
              },
              {
                "$ref": "#/components/schemas/AcAnalysis"
              },
              {
                "$ref": "#/components/schemas/DcAnalysis"
              }
            ],
            "title": "Analysis",
            "discriminator": {
              "propertyName": "kind",
              "mapping": {
                "ac": "#/components/schemas/AcAnalysis",
                "dc": "#/components/schemas/DcAnalysis",
                "op": "#/components/schemas/OpAnalysis",
                "tran": "#/components/schemas/TranAnalysis"
              }
            }
          }
        },
        "type": "object",
        "required": [
          "schematic",
          "analysis"
        ],
        "title": "SimulationRequest"
      },
      "SimulationResult": {
        "properties": {
          "analysis": {
            "type": "string",
            "enum": [
              "op",
              "tran",
              "ac",
              "dc"
            ],
            "title": "Analysis"
          },
          "axis": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Axis"
              },
              {
                "type": "null"
              }
            ]
          },
          "traces": {
            "items": {
              "$ref": "#/components/schemas/Trace"
            },
            "type": "array",
            "title": "Traces"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/Diagnostic"
            },
            "type": "array",
            "title": "Errors"
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/Diagnostic"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "type": "object",
        "required": [
          "analysis"
        ],
        "title": "SimulationResult"
      },
      "Text": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Stable unique id (e.g. 't1')."
          },
          "position": {
            "$ref": "#/components/schemas/Point",
            "description": "Top-left corner of the text."
          },
          "content": {
            "type": "string",
            "maxLength": 2000,
            "title": "Content",
            "description": "Text as typed, line breaks included."
          }
        },
        "type": "object",
        "required": [
          "id",
          "position",
          "content"
        ],
        "title": "Text",
        "description": "Free text on the schematic (title, note...). Decorative only: the netlist ignores it."
      },
      "TextOffset": {
        "properties": {
          "x": {
            "type": "number",
            "title": "X"
          },
          "y": {
            "type": "number",
            "title": "Y"
          }
        },
        "type": "object",
        "required": [
          "x",
          "y"
        ],
        "title": "TextOffset",
        "description": "Where a text of a component is drawn, relative to the component, in grid units.\n\nThe offset points to the centre of the text, in the component's own frame (before the\nmirror and the rotation): a text placed by hand turns with its component and stays on the\nsame side of it, while the text itself is always drawn upright. The editor snaps it to half\na grid step."
      },
      "Trace": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "ngspice vector name, e.g. 'v(out)' or 'i(R1)'."
          },
          "kind": {
            "type": "string",
            "enum": [
              "voltage",
              "current"
            ],
            "title": "Kind"
          },
          "unit": {
            "type": "string",
