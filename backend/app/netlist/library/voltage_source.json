{
  "type": "voltage_source",
  "label": "Source de tension",
  "prefix": "V",
  "pins": [
    { "name": "+", "x": 0, "y": -2 },
    { "name": "-", "x": 0, "y": 2 }
  ],
  "params": [
    {
      "name": "waveform",
      "label": "Forme d'onde",
      "default": "dc",
      "kind": "choice",
      "options": ["dc", "pulse", "sin"]
    },
    { "name": "dc", "label": "Tension continue", "unit": "V", "default": "5" },
    { "name": "v1", "label": "Tension basse", "unit": "V", "default": "0" },
    { "name": "v2", "label": "Tension haute", "unit": "V", "default": "5" },
    { "name": "delay", "label": "Retard", "unit": "s", "default": "0" },
    { "name": "rise", "label": "Temps de montée", "unit": "s", "default": "1n" },
    { "name": "fall", "label": "Temps de descente", "unit": "s", "default": "1n" },
    { "name": "width", "label": "Durée haute", "unit": "s", "default": "1m" },
    { "name": "period", "label": "Période", "unit": "s", "default": "2m" },
    { "name": "offset", "label": "Décalage", "unit": "V", "default": "0" },
    { "name": "amplitude", "label": "Amplitude", "unit": "V", "default": "1" },
    { "name": "frequency", "label": "Fréquence", "unit": "Hz", "default": "1k" },
    { "name": "damping", "label": "Amortissement", "unit": "1/s", "default": "0" },
    { "name": "phase", "label": "Phase", "unit": "°", "default": "0" }
  ],
  "spice": "{name} {pin:+} {pin:-} {waveform}",
  "waveforms": {
    "dc": "DC {dc}",
    "pulse": "PULSE({v1} {v2} {delay} {rise} {fall} {width} {period})",
    "sin": "SIN({offset} {amplitude} {frequency} {delay} {damping} {phase})"
  }
}
